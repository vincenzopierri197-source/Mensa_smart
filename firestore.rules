rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAnonymous() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    // Ogni sessione anonima può leggere e modificare esclusivamente
    // il proprio documento. Nessun utente può consultare i dati altrui.
    match /users/{userId} {
      allow read, create, update, delete: if isAnonymous()
        && request.auth.uid == userId;
    }

    // Il codice personale è una credenziale casuale ad alta entropia.
    // Si consente solo la lettura puntuale (get), mai l'elenco dei codici.
    // Il possessore del codice può associare il recupero alla propria sessione.
    match /recoveryCodes/{codeHash} {
      allow get: if isAnonymous();
      allow list: if false;
      allow create, update: if isAnonymous()
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
